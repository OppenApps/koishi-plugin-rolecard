{
    "name": "koishi-plugin-rolecard",
    "version": "1.9.1",
    "contributors": [
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "main": "lib/index.cjs",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "development": "./src/index.ts",
            "default": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "assets"
    ],
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "workspaces": [
        "."
    ],
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/OppenApps/koishi-plugin-rolecard",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OppenApps/koishi-plugin-rolecard.git"
    },
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "rolecard"
    ],
    "scripts": {
        "build": "tsdown",
        "ts7": "node ../../node_modules/@typescript/native/bin/tsc",
        "typecheck": "yarn ts7 --noEmit",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && yarn typecheck",
        "fix": "biome check --write . && yarn typecheck",
        "changeset": "changeset",
        "release": "changeset version && yarn build && npm publish --access public"
    },
    "peerDependencies": {
        "koishi": "^4.17.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.9",
        "@changesets/cli": "^2.31.1",
        "@types/node": "^26.1.2",
        "@typescript/native": "npm:typescript@7.0.2",
        "tsdown": "^0.22.14"
    },
    "koishi": {
        "description": {
            "en": "Rolecard plugin — data-driven character quote engine",
            "zh": "身份卡插件 · 数据驱动的角色台词引擎，可选加载不同角色卡"
        },
        "service": {}
    }
}
